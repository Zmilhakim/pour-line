    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject pourSpot {\"hint\":\"Empty marker 'KettlePourSpot': kettle origin when snapped over the glass. Its Y is also the carry height.\"}"
